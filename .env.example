MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_API_KEY=

# Main-chain constrained analysis: deterministic | llm
ANALYSIS_MODE=deterministic
# Empty value reuses MODEL_NAME when ANALYSIS_MODE=llm
ANALYSIS_MODEL=
# Optional two-stage analysis. Set true to stream Qwen reasoning as bounded public
# progress metadata, then run a separate non-thinking structured JSON request.
# ANALYSIS_LLM_ENABLE_THINKING=false
ANALYSIS_LLM_THINKING_TTFT_SECONDS=30
ANALYSIS_LLM_THINKING_BUDGET_TOKENS=800
ANALYSIS_LLM_PROCESS_SUMMARY_MAX_CHARS=400
ANALYSIS_LLM_TIMEOUT_SECONDS=60
ANALYSIS_LLM_MAX_RETRY=1
ANALYSIS_LLM_MAX_INPUT_CHARS=30000
ANALYSIS_LLM_MAX_OUTPUT_TOKENS=1200
# M4-B has a larger bounded JSON schema than Risk Narrative / Report Draft.
ANALYSIS_LLM_RESEARCH_MAX_OUTPUT_TOKENS=2400

# Natural-language TaskSpec parsing: deterministic | llm. Keep deterministic
# until a real-call budget is explicitly approved; llm reuses model connection settings.
INTENT_MODE=deterministic
INTENT_MODEL=
INTENT_LLM_MAX_OUTPUT_TOKENS=1600

CHECKPOINT_DB_PATH=checkpoints/credra_agent.db

MAX_RETRY=2
RESEARCH_FAIL_FIRST=0

# Pluggable external research: tavily | snapshot | mock
RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
SEARCH_DEPTH=basic
SEARCH_MAX_RESULTS=5
SEARCH_MIN_RELEVANCE_SCORE=0.5
SEARCH_TIMEOUT_SECONDS=15
SEARCH_TIME_RANGE=year
SEARCH_SNAPSHOT_DIR=data/search_snapshots
SEARCH_SAVE_SNAPSHOTS=1

# Candidate document retrieval: auto maps tavily->http, snapshot->snapshot, mock->disabled
CONTENT_FETCH_PROVIDER=auto
SEARCH_CONTENT_SNAPSHOT_DIR=data/content_snapshots
SEARCH_FETCH_TIMEOUT_SECONDS=15
SEARCH_FETCH_MAX_BYTES=5000000
SEARCH_FETCH_MAX_TEXT_CHARS=2000000
SEARCH_FETCH_MAX_REDIRECTS=3
SEARCH_FETCH_MAX_CONCURRENCY=3
SEARCH_FETCH_MAX_CANDIDATES=10
SEARCH_FETCH_MAX_PDF_PAGES=200

# Claim verification: rules | llm | disabled
FACT_VERIFIER=rules
# Empty value reuses MODEL_NAME when FACT_VERIFIER=llm
FACT_VERIFIER_MODEL=
# Fact Verifier is a strict JSON stage and defaults to non-thinking independently.
# FACT_VERIFIER_ENABLE_THINKING=false
FACT_VERIFIER_MIN_CONFIDENCE=0.75
FACT_VERIFIER_MAX_CANDIDATES=10
FACT_VERIFIER_MAX_INPUT_CHARS=30000
FACT_VERIFIER_TIMEOUT_SECONDS=30
FACT_VERIFIER_MAX_RETRY=1
VERIFICATION_SNAPSHOT_DIR=data/verification_snapshots

DEBT_RATIO_THRESHOLD=0.15
CASHFLOW_THRESHOLD=0.0
REVENUE_THRESHOLD=0.20

DATA_DIR=data
TRACE_DIR=traces

# Whole-service logging. Decimal MB; all MCP children share the root startup.
SERVICE_LOG_DIR=logs
SERVICE_LOG_MAX_BYTES=10000000
SERVICE_LOG_QUEUE_CAPACITY=1024
SERVICE_LOG_ENQUEUE_TIMEOUT=2
SERVICE_LOG_ACK_TIMEOUT=5
SERVICE_LOG_SHUTDOWN_TIMEOUT=10
