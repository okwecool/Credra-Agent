MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_API_KEY=

CHECKPOINT_DB_PATH=checkpoints/credra_agent.db

MAX_RETRY=2
RESEARCH_FAIL_FIRST=0

# Pluggable external research: tavily | snapshot | mock
RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
SEARCH_DEPTH=basic
SEARCH_MAX_RESULTS=5
SEARCH_MIN_RELEVANCE_SCORE=0.5
SEARCH_TIMEOUT_SECONDS=15
SEARCH_TIME_RANGE=year
SEARCH_SNAPSHOT_DIR=data/search_snapshots
SEARCH_SAVE_SNAPSHOTS=1

DEBT_RATIO_THRESHOLD=0.15
CASHFLOW_THRESHOLD=0.0
REVENUE_THRESHOLD=0.20

DATA_DIR=data
TRACE_DIR=traces
